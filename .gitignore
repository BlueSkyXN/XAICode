# WorkBuddy agent state (local-only)
/.workbuddy

# Override global gitignore (**/local/) — keep all crate-local `local/` modules
# (e.g. xai-grok-tools/src/computer/local, xai-agent-lifecycle/src/local, etc.)
!/**/local/

# Local build configuration (protoc wrapper, cargo config)
/.cargo/

# Repository reference sources (audit baseline, not part of the product)
/local/

# Build artifacts
/target/

# Rust backup files
**/*.rs.bk

# macOS
.DS_Store

# Editors
**/.vscode/
**/.idea/
